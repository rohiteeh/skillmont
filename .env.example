# SkillMint Backend Environment Configuration Template
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=skillmint_secure_jwt_token_key_2026_bca_project
JWT_EXPIRES_IN=7d

# Database Configuration (sqlite, mysql, or postgres)
DB_TYPE=sqlite
SQLITE_PATH=./skillmint.db

# Cloud Database Connection String (Aiven MySQL / Neon PostgreSQL / Supabase)
# Paste this directly into Vercel Environment Variables or your local .env:
# DATABASE_URL=mysql://avnadmin:password@mysql-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# or
# DATABASE_URL=postgres://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local MySQL Settings (Active when DB_TYPE=mysql without a connection URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skillmint_db

# CORS Configuration
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173
